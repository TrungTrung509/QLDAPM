# ============================================================
# CẤU HÌNH CREWLY DOCKER — DỰ ÁN ATELIERX (FASHION STUDIO)
# ============================================================
# Ghi chú: Tất cả các biến môi trường bên dưới đều là TÙY CHỌN.
# Bạn có thể khởi động ngay hệ thống bằng: docker compose up -d --build
# mà không bắt buộc phải điền API Key.
# ============================================================

# Cổng truy cập Web UI Crewly (Mặc định: 8787 -> http://localhost:8787)
WEB_PORT=8787

# Đường dẫn thư mục dự án trên máy Host (Mặc định: .. tức thư mục cha)
HOST_PROJECT_PATH=..

# Runtime mặc định cho các Agent
DEFAULT_RUNTIME=antigravity-cli

# (Tùy chọn) Gemini API Key - Nếu bạn muốn Agent chạy trực tiếp qua Gemini API CLI
# GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) GitHub Personal Access Token - Nếu muốn Agent commit/push code
# GITHUB_TOKEN=your_github_token_here
