# ============================================================
# CẤU HÌNH CREWLY DOCKER - QLDA TEAM
# ============================================================

# 1. Gemini API Key (Bắt buộc để Antigravity CLI / Gemini Model chạy)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Personal Access Token (Cho phép Agent commit & push code)
GITHUB_TOKEN=your_github_token_here

# 3. Cổng truy cập Web UI Crewly (Truy cập tại http://localhost:8787)
WEB_PORT=8787

# 4. Runtime mặc định cho các Agent
DEFAULT_RUNTIME=antigravity-cli

# 5. Đường dẫn thư mục dự án trên máy Host (Mặc định: .. tức thư mục chứa crewly-docker)
HOST_PROJECT_PATH=..
